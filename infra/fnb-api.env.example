# Môi trường của API (fnb-api.service đọc qua EnvironmentFile).
# Chép thành /etc/fnb/fnb-api.env, chủ root, nhóm fnb, quyền 640:
#   sudo install -o root -g fnb -m 640 infra/fnb-api.env.example /etc/fnb/fnb-api.env
# rồi thay mọi chỗ <...>. File này KHÔNG có giá trị thật; file thật không bao giờ vào git.
# Sai hoặc thiếu biến bắt buộc ⇒ API không chạy và in tên biến (không in giá trị).
# Kiểm sau khi sửa: pnpm ops:preflight (xem infra/README.md).

# --- Bắt buộc ---------------------------------------------------------------

# development | production. Không có mặc định: quên đặt thì API dừng, không chạy nhầm
# với nhà cung cấp hóa đơn giả của môi trường dev.
FNB_ENV=production

# Kết nối của role app (fnb_app): chỉ DML, bị RLS ràng buộc. API từ chối chạy nếu role
# này là SUPERUSER hoặc BYPASSRLS. pnpm db:provision in ra đúng chuỗi này (mật khẩu thay
# bằng chữ PASSWORD). Mật khẩu có ký tự đặc biệt phải mã hóa URL (%40 cho @ ...).
FNB_DATABASE_URL=postgresql://fnb_app:<FNB_APP_PASSWORD>@127.0.0.1:5432/fnb

# Nhà cung cấp hóa đơn điện tử: hiện chỉ có `none` (chi nhánh không bật được HĐĐT).
# `fake` bị từ chối ở production.
FNB_EINVOICE_PROVIDER=none

# Origin (scheme://host[:port]) của trang được phép gửi lệnh ghi; POS và backoffice
# cùng một origin sau Caddy nên thường chỉ một giá trị. Có đường dẫn ⇒ bị từ chối.
FNB_ALLOWED_ORIGINS=https://<quan.example.vn>

# --- Nên có -----------------------------------------------------------------

# 32 byte base64 niêm phong secret cổng thanh toán (SePay/PayOS) trong DB. Thiếu ⇒ không
# nhận báo có của ngân hàng, QR không tự xác nhận. MẤT KHÓA = mọi secret đã lưu không mở
# được nữa ⇒ giữ một bản ở nơi khác (két mật khẩu của chủ), không để cạnh file backup.
# Sinh: openssl rand -base64 32
FNB_PAYMENT_SECRET_KEY=<openssl rand -base64 32>

# Proxy được tin X-Forwarded-For (địa chỉ hoặc dải CIDR, cách nhau dấu phẩy). API nghe ở
# 127.0.0.1 sau Caddy ⇒ PHẢI đặt, nếu không mọi khách cùng một địa chỉ 127.0.0.1 và giới
# hạn tần suất theo địa chỉ chặn cả quán. Không bao giờ đặt dải của Internet.
FNB_TRUSTED_PROXIES=127.0.0.1,::1

# --- Có mặc định an toàn (bỏ trống = mặc định) ------------------------------

# Địa chỉ và cổng API nghe. Giữ 127.0.0.1: chỉ Caddy trên cùng máy gọi vào.
HOST=127.0.0.1
PORT=3000

# Cookie phiên backoffice Secure + tiền tố __Host-. Production từ chối false.
# FNB_COOKIE_SECURE=true

# Chu kỳ worker hóa đơn điện tử (ms, ≥ 1000). Chỉ chạy khi provider là fake.
# FNB_EINVOICE_WORKER_INTERVAL_MS=5000

# Giới hạn tần suất: số yêu cầu mỗi cửa sổ, tính trong bộ nhớ của MỘT tiến trình (chạy
# nhiều tiến trình thì mỗi tiến trình cho đủ số này). Quá ⇒ 429 API_RATE_LIMITED + Retry-After.
# FNB_RATE_LIMIT_WINDOW_SECONDS=60
# Đăng nhập backoffice, theo địa chỉ khách (cả quán thường chung một IP) và theo tài khoản.
# FNB_RATE_LIMIT_LOGIN_PER_ADDRESS=30
# FNB_RATE_LIMIT_LOGIN_PER_ACCOUNT=10
# Ghép máy quầy bằng mã, theo địa chỉ.
# FNB_RATE_LIMIT_PAIRING_PER_ADDRESS=10
# Đăng nhập PIN + duyệt tại máy quầy, theo địa chỉ (mọi máy của quán) và theo từng máy.
# FNB_RATE_LIMIT_TILL_PER_ADDRESS=300
# FNB_RATE_LIMIT_TILL_PER_DEVICE=60

# Job dọn mã ghép hết hạn và phiên (backoffice + nhân viên) đã hết hạn quá N ngày.
# Không đụng audit, change_log, approval. Nhiều tiến trình cùng DB ⇒ chỉ bật ở một.
# FNB_CLEANUP_ENABLED=true
# FNB_CLEANUP_INTERVAL_MINUTES=60
# FNB_SESSION_RETENTION_DAYS=30

# /etc/fnb/backup.env — quyền 640, chủ root, nhóm fnbbackup. install-release.sh đọc file này
# (bằng user fnbbackup) để backup trước khi chạy migration; cron có thể dùng cùng giá trị.
# Mật khẩu role fnb_backup nằm trong ~fnbbackup/.pgpass, không ghi ở đây.
FNB_PG_BIN_DIR=/usr/lib/postgresql/17/bin
FNB_BACKUP_DATABASE_URL=postgresql://fnb_backup@127.0.0.1:5432/fnb
FNB_BACKUP_DIRECTORY=/var/backups/fnb
FNB_BACKUP_KEEP=14

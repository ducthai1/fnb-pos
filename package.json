{
  "name": "fnb-pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "turbo run test:unit",
    "test:api": "turbo run test:api",
    "verify": "turbo run typecheck && eslint . --max-warnings=0 && turbo run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}

{
  "name": "fnb-pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "turbo run test:unit",
    "test:api": "turbo run test:api",
    "test:sync": "turbo run test:sync",
    "test:browser": "turbo run test:browser",
    "test:ops": "pnpm --filter @fnb/scripts exec vitest run --config vitest.ops.config.ts",
    "e2e": "turbo run test:browser",
    "verify": "turbo run typecheck && eslint . --max-warnings=0 && turbo run test:unit",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=@fnb/backoffice && pnpm --filter @fnb/pos exec vite build --base=/pos/",
    "api:start": "pnpm --filter @fnb/api start",
    "db:provision": "node --import tsx scripts/src/provision/provision-database-cli.ts",
    "ops:backup": "node --import tsx scripts/src/ops/backup-cli.ts",
    "ops:restore": "node --import tsx scripts/src/ops/restore-cli.ts",
    "ops:new-server-generation": "node --import tsx scripts/src/ops/new-server-generation-cli.ts",
    "ops:preflight": "pnpm --filter @fnb/api exec node --import tsx src/ops/preflight-cli.ts",
    "dev:stack": "node --import tsx scripts/src/dev-stack/start-dev-stack.ts",
    "dev:bank-notice": "node --import tsx scripts/src/bank-notice/send-bank-notice-cli.ts",
    "docs:shots:backoffice": "node --import tsx e2e/backoffice/docs-shots/take-backoffice-shots.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-x64",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
